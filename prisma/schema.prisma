// Prisma schema — CRM New Palace
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis de acesso (RBAC). Espelha os perfis usados no frontend.
enum Role {
  admin
  gerente
  corretor
}

/// Situação do usuário no sistema.
enum UserStatus {
  ativo
  inativo
}

/// Usuário do sistema (login, RBAC e gestão de equipe).
model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  phone     String?
  cargo     String?
  role      Role       @default(corretor)
  status    UserStatus @default(ativo)
  avatar    String?

  lastLoginAt DateTime?

  // Hash do refresh token atual (para logout/refresh seguro).
  hashedRefreshToken String?

  // Proteção contra força bruta: bloqueia a conta após falhas consecutivas.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Fluxo de recuperação de senha.
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // Carteira de leads/clientes atribuídos a este corretor.
  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

/// Lead / cliente da imobiliária. Alimenta as telas de Leads, Clientes e Funil.
/// stage, interesse e prioridade são strings validadas na API (paridade 1:1
/// com os identificadores usados no frontend, inclusive acentos e hífens).
model Lead {
  id         String   @id @default(uuid())
  nome       String
  telefone   String
  email      String
  origem     String
  interesse  String // Comprar | Alugar | Investir
  faixa      String
  cidade     String
  bairro     String
  stage      String   @default("novo")
  prioridade String   @default("Média")
  valor      Int      @default(0)
  tags       String[] @default([])

  // Corretor dono do lead. Fica nulo se o corretor for removido (SetNull),
  // preservando o histórico do lead.
  corretor   User?   @relation(fields: [corretorId], references: [id], onDelete: SetNull)
  corretorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([corretorId])
  @@index([createdAt])
  @@map("leads")
}

/// Motivo de uma tentativa de login recusada (para auditoria).
enum LoginFailureReason {
  senha_incorreta
  usuario_inexistente
  conta_bloqueada
  usuario_inativo
}

/// Trilha de auditoria de acessos — permite detectar ataques de força bruta.
model LoginAttempt {
  id        String              @id @default(uuid())
  email     String
  success   Boolean
  reason    LoginFailureReason?
  ip        String?
  userAgent String?
  createdAt DateTime            @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}
